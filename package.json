{
  "name": "tiendataudio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test tests/*.test.ts",
    "social:facebook-gallery": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/facebook-gallery-worker.ts",
    "db:seed": "node scripts/seed-mongodb.mjs",
    "db:migrate-content": "node scripts/migrate-content.mjs",
    "db:migrate-social-slugs": "node scripts/migrate-social-source-slugs.mjs",
    "db:hash-password": "node scripts/hash-password.mjs",
    "db:seed-editorial": "node --env-file-if-exists=.env.local scripts/seed-editorial-drafts.mjs",
    "db:seed-editorial-queue": "node --env-file-if-exists=.env.local scripts/seed-editorial-research-queue.mjs",
    "db:assign-editorial-images": "node --env-file-if-exists=.env.local scripts/assign-editorial-temp-images.mjs",
    "db:publish-editorial-queue": "node --env-file-if-exists=.env.local scripts/publish-editorial-queue.mjs",
    "db:apply-editorial-batch": "node --env-file-if-exists=.env.local scripts/apply-editorial-batch.mjs",
    "db:complete-editorial": "node --env-file-if-exists=.env.local scripts/complete-editorial-corpus.mjs",
    "db:qa-editorial": "node --env-file-if-exists=.env.local scripts/qa-editorial-corpus.mjs",
    "assistant:migrate": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/migrate-assistant-knowledge.ts",
    "assistant:eval": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/run-assistant-evaluations.ts",
    "assistant:graph": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/manage-assistant-graph.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.12",
    "github-slugger": "^2.0.0",
    "lucide-react": "^0.544.0",
    "mongodb": "^7.5.0",
    "next": "^15.5.27",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-dropzone": "^14.3.8",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "tsx": "4.23.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.27",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "lodash": "^4.18.1",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.26",
    "sharp": "^0.35.3",
    "source-map-js": "^1.2.2"
  }
}
